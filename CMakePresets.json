{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "KIM_KV_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU Release",
      "description": "Release build for CPU contracts and metadata benchmarks",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build-k5-cpu-release",
      "cacheVariables": {
        "KIM_KV_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA Release (SM 86)",
      "description": "Release build for the RTX 3060 CUDA baseline",
      "inherits": "release-base",
      "binaryDir": "${sourceDir}/build-k5-cuda-release",
      "cacheVariables": {
        "KIM_KV_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "cuda-release-reference",
      "displayName": "CUDA Release Reference (SM 86)",
      "description": "Two-stage paged attention reference build",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build-k5-cuda-reference",
      "cacheVariables": {
        "KIM_KV_ENABLE_FUSED_ATTENTION": "OFF",
        "KIM_KV_ENABLE_DESCRIPTOR_CURSOR": "OFF"
      }
    },
    {
      "name": "cuda-release-fused",
      "displayName": "CUDA Release Fused (SM 86)",
      "description": "Fused paged attention with page-wise descriptor traversal",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build-k5-cuda-fused",
      "cacheVariables": {
        "KIM_KV_ENABLE_FUSED_ATTENTION": "ON",
        "KIM_KV_ENABLE_DESCRIPTOR_CURSOR": "ON"
      }
    },
    {
      "name": "cuda-release-fused-no-cursor",
      "displayName": "CUDA Release Fused without Descriptor Cursor (SM 86)",
      "description": "Fused paged attention A/B baseline with per-token descriptor lookup",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build-k5-cuda-fused-no-cursor",
      "cacheVariables": {
        "KIM_KV_ENABLE_FUSED_ATTENTION": "ON",
        "KIM_KV_ENABLE_DESCRIPTOR_CURSOR": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release"
    },
    {
      "name": "cuda-release-reference",
      "configurePreset": "cuda-release-reference"
    },
    {
      "name": "cuda-release-fused",
      "configurePreset": "cuda-release-fused"
    },
    {
      "name": "cuda-release-fused-no-cursor",
      "configurePreset": "cuda-release-fused-no-cursor"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release-reference",
      "configurePreset": "cuda-release-reference",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release-fused",
      "configurePreset": "cuda-release-fused",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release-fused-no-cursor",
      "configurePreset": "cuda-release-fused-no-cursor",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
